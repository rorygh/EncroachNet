FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

WORKDIR /workspace/EncroachNet

# Install uv for fast installs
RUN pip install uv

# Copy and install dependencies
COPY requirements.txt .
RUN uv pip install --system spconv-cu124
RUN uv pip install --system -r requirements.txt

# Copy source
COPY . .

# TensorBoard (train2d.py logs to runs/ via TensorBoardLogger) -- expose the port here
# for documentation; on RunPod it still needs to be added under the pod's
# Expose HTTP Ports setting to actually be reachable.
EXPOSE 6006

# Default: drop into bash; training/inference launched manually
CMD ["/bin/bash"]
